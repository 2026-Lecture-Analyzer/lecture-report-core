# 사용하는 LLM 제공자의 키만 채우세요. 실제 .env 파일은 커밋되지 않습니다.
# config.py 가 시작 시 이 .env 를 자동 로드합니다(python-dotenv).

# ── 제공자 스위치 ───────────────────────────────────────────────────────
# 생성·임베딩 백엔드를 한 번에 전환: upstage(기본) | google
# (생성/임베딩 따로 섞으려면 MODEL_BACKEND / EMBED_BACKEND 를 개별 지정)
LLM_BACKEND=upstage

# 백엔드 = upstage 일 때 필요. https://console.upstage.ai 에서 발급
UPSTAGE_API_KEY=

# 백엔드 = google 일 때 필요(Gemini API 키). https://aistudio.google.com/apikey 에서 발급
GOOGLE_API_KEY=

# (선택) 다른 제공자
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
